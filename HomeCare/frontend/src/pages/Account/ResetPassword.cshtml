@model HomeCare.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Tilbakestill passord";
}

<div class="signup-container container">
    <div class="signup-card">
        <h2 class="text-center mb-4">Tilbakestill passord</h2>
        <p class="text-center text-muted mb-4">
            Skriv inn ditt nye passord.
        </p>

        <form asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Nytt passord</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Minimum 6 tegn" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Bekreft passord</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Skriv inn passordet på nytt" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-main btn-lg px-4 py-2 bg-green shadow-lg">Tilbakestill passord</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}