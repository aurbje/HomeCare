@model HomeCare.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Glemt passord";
}

<div class="signup-container container">
    <div class="signup-card">
        <a asp-controller="Account" asp-action="SignIn" class="back-btn">← Tilbake til innlogging</a>

        <h2 class="text-center mb-4">Glemt passord?</h2>
        <p class="text-center text-muted mb-4">
            Skriv inn din e-postadresse så sender vi deg en lenke for å tilbakestille passordet.
        </p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            
            <div class="mb-4">
                <label asp-for="Email" class="form-label">E-postadresse</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="F.eks. anna@epost.no" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-main btn-lg px-4 py-2 bg-green shadow-lg">Send tilbakestillingslenke</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}