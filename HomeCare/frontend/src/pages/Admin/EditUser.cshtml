@model HomeCare.Models.User

@{
    ViewData["Title"] = "Rediger bruker";
}

<div class="container py-4">
    <h1 class="h4 mb-3">Rediger bruker: @Model.FullName</h1>

    <form method="post" action="/Admin/EditUser/@Model.Id">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="FullName" class="form-label">Fullt navn</label>
            <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.FullName" required />
        </div>

        <div class="mb-3">
            <label for="Email" class="form-label">E-post</label>
            <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" required />
        </div>

        <div class="mb-3">
            <label for="TlfNumber" class="form-label">Telefon</label>
            <input type="text" class="form-control" id="TlfNumber" name="TlfNumber" value="@Model.TlfNumber" />
        </div>

        <div class="mb-3">
            <label for="Address" class="form-label">Adresse</label>
            <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" />
        </div>

        <div class="mb-3">
            <label for="Role" class="form-label">Rolle</label>
            <select class="form-select" id="Role" name="Role">
                <option value="User" selected="@(Model.Role == "User")">User</option>
                <option value="Ansatt" selected="@(Model.Role == "Ansatt")">Ansatt</option>
                <option value="admin" selected="@(Model.Role == "admin")">Admin</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Lagre endringer</button>
        <a href="/Admin/Users" class="btn btn-outline-secondary">Avbryt</a>
    </form>
</div>