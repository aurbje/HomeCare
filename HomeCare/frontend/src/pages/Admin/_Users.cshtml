@model IEnumerable<HomeCare.Models.User>

@{
    ViewData["Title"] = "Administrer brukere";
    var search = ViewBag.SearchTerm as string ?? string.Empty;
}

<div class="container py-4">
    <h1 class="h4 mb-3">Brukere (@Model.Count())</h1>

       @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" action="/Admin/Users" class="row g-2 mb-3">
        <div class="col-auto">
            <input name="q" value="@search" class="form-control form-control-sm" placeholder="Søk navn / e-post" />
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-primary">Søk</button>
        </div>
        <div class="col-auto">
            <a href="/Admin/Users" class="btn btn-sm btn-outline-secondary">Nullstill</a>
        </div>
    </form>

    <table class="table table-sm table-striped align-middle">
        <thead>
        <tr>
            <th>ID</th>
            <th>Navn</th>
            <th>E-post</th>
            <th>Adresse</th>
            <th>Telefon</th>
            <th>Rolle</th>
            <th>Endre</th>
            <th>Slette</th>

        </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-muted">Ingen brukere funnet.</td></tr>
        }
        else
        {
            foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Address</td>
                    <td>@u.TlfNumber</td>
                    <td><span class="badge bg-@(u.Role == "admin" ? "danger" : "secondary")">@u.Role</span></td>
                    <td>
                        <a href="/Admin/EditUser/@u.Id" class="btn btn-sm btn-warning">Endre</a>
                    </td>
                    <td>
                        <form method="post" action="/Admin/DeleteUser" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="button"
                                    class="btn btn-sm btn-danger confirm-delete"
                                    data-confirm="Er du sikker på at du vil slette @u.FullName?">
                                Slette
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>

    <a href="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">Tilbake</a>
</div>