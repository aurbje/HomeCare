@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <h1 class="mb-4 text-center">Adminpanel</h1>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <a class="text-decoration-none" href="/Admin/Users">
                <div class="card shadow-sm h-100 border-0 hover-shadow">
                    <div class="card-body text-center py-4">
                        <div class="display-6 mb-3">👥</div>
                        <h2 class="h5">Brukere</h2>
                        <p class="text-muted small mb-0">Administrer brukerkontoer og roller</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a class="text-decoration-none" href="/Admin/Bookings">
                <div class="card shadow-sm h-100 border-0 hover-shadow">
                    <div class="card-body text-center py-4">
                        <div class="display-6 mb-3">📅</div>
                        <h2 class="h5">Bookinger</h2>
                        <p class="text-muted small mb-0">Se og juster bookingdata</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a class="text-decoration-none" href="/Admin/Personnel">
                <div class="card shadow-sm h-100 border-0 hover-shadow">
                    <div class="card-body text-center py-4">
                        <div class="display-6 mb-3">🧑‍⚕️</div>
                        <h2 class="h5">Ansatte</h2>
                        <p class="text-muted small mb-0">Håndter tilgjengelighet og tilganger</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover { box-shadow: 0 0.75rem 1.25rem rgba(0,0,0,.15); transition: box-shadow .2s; }
</style>