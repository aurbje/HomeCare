@model IEnumerable<HomeCare.Models.User>

@{
    ViewData["Title"] = "Administrer personell";
    var search = ViewBag.SearchTerm as string ?? string.Empty;
}

<div class="container py-4">
    <h1 class="h4 mb-3">Ansatte (@Model.Count())</h1>

     @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" action="/Admin/Personnel" class="row g-2 mb-3">
        <div class="col-auto">
            <input name="q" value="@search" class="form-control form-control-sm" placeholder="Søk navn / e-post" />
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-primary">Søk</button>
        </div>
        <div class="col-auto">
            <a href="/Admin/Personnel" class="btn btn-sm btn-outline-secondary">Nullstill</a>
        </div>
    </form>

    <table class="table table-sm table-striped align-middle">
        <thead>
        <tr>
            <th>BrukerID</th>
            <th>AnsattID</th>
            <th>Navn</th>
            <th>E-post</th>
            <th>Telefon</th>
            <th>Adresse</th>
            <th>Rolle</th>
            <th>Endre</th>
            <th>Slette</th>
        </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-muted">Ingen personell funnet.</td></tr>
        }
        else
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.PersonnelId</td>
                    <td>@p.FullName</td>
                    <td>@p.Email</td>
                    <td>@p.TlfNumber</td>
                    <td>@p.Address</td>
                    <td><span class="badge bg-info">@p.Role</span></td>
                    <td>
                        <a href="/Admin/EditPersonnel/@p.Id" class="btn btn-sm btn-primary">Endre</a>
                    </td>
                    <td>
                    <form method="post" action="/Admin/DeletePersonnel" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="button"
                                    class="btn btn-sm btn-danger confirm-delete"
                                    data-confirm="Er du sikker på at du vil slette @p.FullName?">
                                Slette
                            </button>
                    </form>        
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>

    <a href="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">Tilbake</a>
</div>