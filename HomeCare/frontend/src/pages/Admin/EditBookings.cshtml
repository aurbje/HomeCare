@model HomeCare.Models.Booking

@{
    ViewData["Title"] = "Rediger booking";
    var clients = ViewBag.Clients as List<HomeCare.Models.User>;
    var personnel = ViewBag.Personnel as List<HomeCare.Models.User>;
}

<div class="container py-4">
    <h1 class="h4 mb-3">Rediger booking: #@Model.Id</h1>

    <form method="post" action="/Admin/EditBooking/@Model.Id">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="ClientId" class="form-label">Kunde</label>
            <select class="form-select" id="ClientId" name="ClientId" required>
                <option value="">-- Velg kunde --</option>
                @if (clients != null)
                {
                    foreach (var client in clients)
                    {
                        <option value="@client.Id" selected="@(Model.ClientId == client.Id)">
                            @client.FullName (@client.Email)
                        </option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="PersonnelId" class="form-label">Ansatt</label>
            <select class="form-select" id="PersonnelId" name="PersonnelId">
                <option value="">-- Velg ansatt --</option>
                @if (personnel != null)
                {
                    foreach (var person in personnel)
                    {
                        <option value="@person.Id" selected="@(Model.PersonnelId == person.Id)">
                            @person.FullName (@person.Email)
                        </option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="Date" class="form-label">Dato</label>
            <input type="date" class="form-control" id="Date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" required />
        </div>

        <div class="mb-3">
            <label for="Time" class="form-label">Tid</label>
            <input type="text" class="form-control" id="Time" name="Time" value="@Model.Time" placeholder="09:00–10:00" required />
        </div>

        <div class="mb-3">
            <label for="ServiceType" class="form-label">Tjenestetype</label>
            <select class="form-select" id="ServiceType" name="ServiceType" required>
                <option value="Cleaning" selected="@(Model.ServiceType == "Cleaning")">Cleaning</option>
                <option value="Nursing" selected="@(Model.ServiceType == "Nursing")">Nursing</option>
                <option value="Cooking" selected="@(Model.ServiceType == "Cooking")">Cooking</option>
                <option value="Other" selected="@(Model.ServiceType == "Other")">Other</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="Notes" class="form-label">Notater</label>
            <textarea class="form-control" id="Notes" name="Notes" rows="3">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Lagre endringer</button>
        <a href="/Admin/Bookings" class="btn btn-outline-secondary">Avbryt</a>
    </form>
</div>